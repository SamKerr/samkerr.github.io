---
import BaseLayout from '../layouts/BaseLayout.astro';
import { education, experience, summary } from '../data/cv';
---

<BaseLayout title="CV - Sam Kerr" description="An overview of Sam Kerr's experience">
	<main class="wrapper stack gap-10 lg:gap-20">
		<p class="intro">{summary}</p>

		<section class="stack gap-4">
			<h2 class="section-title">Experience</h2>
			<ol class="rows">
				{
					experience.map((role) => (
						<li class="row">
							<p class="dates">{role.dates}</p>
							<div class="details">
								<h3>
									{role.title} <span class="org">· {role.company}</span>
								</h3>
								<p class="summary">{role.summary}</p>
								<ul class="tags">
									{role.tools.map((t) => (
										<li>{t}</li>
									))}
								</ul>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<section class="stack gap-4">
			<h2 class="section-title">Education</h2>
			<ol class="rows">
				{
					education.map((ed) => (
						<li class="row">
							<p class="dates">{ed.dates}</p>
							<div class="details">
								<h3>
									{ed.qualification} <span class="org">· {ed.institution}</span>
								</h3>
								<p class="summary">{ed.summary}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>
	</main>
</BaseLayout>

<style>
	.intro {
		max-width: 50ch;
		font-size: var(--text-lg);
		color: var(--gray-200);
	}

	.section-title {
		font-size: var(--text-2xl);
		color: var(--gray-0);
	}

	.rows {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.row {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		padding-block: 1.5rem;
		border-top: 1px solid var(--gray-800);
	}

	.row:last-child {
		padding-bottom: 0;
	}

	.dates {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--gray-400);
		white-space: nowrap;
	}

	.details {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 65ch;
	}

	h3 {
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 600;
		line-height: 1.3;
		color: var(--gray-0);
	}

	.org {
		font-weight: 400;
		color: var(--gray-300);
	}

	.summary {
		margin: 0;
		color: var(--gray-200);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.tags li {
		padding: 0.15rem 0.55rem;
		font-size: 0.8rem;
		white-space: nowrap;
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
		border-radius: 999rem;
	}

	/* Desktop: dates in a fixed left column, aligned with the role title. */
	@media (min-width: 50em) {
		.row {
			display: grid;
			grid-template-columns: 10rem 1fr;
			gap: 2rem;
			padding-block: 2rem;
		}

		.dates {
			/* Match the h3's line box so the two baselines line up. */
			line-height: calc(var(--text-lg) * 1.3);
		}
	}
</style>
