---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, projects } from '../data/projects';

const groups = categories
	.map((category) => ({ ...category, items: projects.filter((p) => p.category === category.id) }))
	.filter((group) => group.items.length > 0);
---

<BaseLayout title="Sam Kerr" description="Sam Kerr, Senior Software Engineer. Side projects and open source work.">
	<main class="wrapper stack gap-10 lg:gap-20">
		<section class="stack gap-10">
			<h2 class="section-title">Projects</h2>
			{
				groups.map((group) => (
					<div class="group stack gap-4">
						<header class="group-header">
							<h3 class="group-title">{group.label}</h3>
						</header>
						<ul class="projects">
							{group.items.map((project) => (
								<li>
									<article class="card">
										<div class="card-header">
											<div class="card-title">
												<h4>
													<a class="card-link" href={project.url} target="_blank" rel="noopener noreferrer">
														{project.name}
													</a>
												</h4>
												{project.liveUrl && (
													<a class="live-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
														<span class="live-dot" aria-hidden="true" />
														Live site
														<span class="live-arrow" aria-hidden="true">↗</span>
													</a>
												)}
											</div>
											<Icon icon="arrow-right" size="1.2em" />
										</div>
										<p>{project.description}</p>
										<div class="tools">
											<ul class="tags">
												{project.tools.map((tool) => (
													<li>{tool}</li>
												))}
											</ul>
										</div>
									</article>
								</li>
							))}
						</ul>
					</div>
				))
			}
			<p class="more">
				More on <a href="https://github.com/SamKerr" target="_blank" rel="noopener noreferrer">GitHub</a>.
			</p>
		</section>
	</main>
</BaseLayout>

<style>
	.section-title {
		font-size: var(--text-2xl);
		color: var(--gray-0);
	}

	.group-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.group-title {
		font-size: var(--text-xl);
		font-family: var(--font-brand);
		color: var(--gray-0);
	}

	.projects {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
		gap: 1.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.projects li {
		display: flex;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		width: 100%;
		padding: 1.5rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		box-shadow: var(--shadow-sm);
		color: var(--gray-300);
		text-decoration: none;
		transition:
			box-shadow var(--theme-transition),
			border-color var(--theme-transition);
	}

	.card:hover,
	.card:focus-within {
		box-shadow: var(--shadow-md);
		border-color: var(--accent-regular);
	}

	.card-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		color: var(--gray-0);
	}

	.card-title {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.75rem;
	}

	h4 {
		font-size: var(--text-lg);
		font-family: var(--font-brand);
		font-weight: 600;
	}

	.card p {
		flex-grow: 1;
		margin: 0;
	}

	/* Stretch the title link over the whole card so the card is clickable. */
	.card-link {
		color: inherit;
		text-decoration: none;
		outline: none;
	}

	.card-link::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	/* Sits above the stretched card link so it gets its own click. */
	.live-link {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.3rem 0.7rem;
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1;
		color: var(--link-color);
		text-decoration: none;
		border: 1px solid var(--accent-regular);
		border-radius: 999rem;
		transition:
			background-color var(--theme-transition),
			color var(--theme-transition);
	}

	.live-link:hover,
	.live-link:focus-visible {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
	}

	.live-link:focus-visible {
		outline: 2px solid var(--accent-regular);
		outline-offset: 2px;
	}

	.live-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background-color: currentColor;
		box-shadow: 0 0 0 0.2rem var(--accent-overlay);
	}

	.live-arrow {
		transition: transform var(--theme-transition);
	}

	.live-link:hover .live-arrow,
	.live-link:focus-visible .live-arrow {
		transform: translate(2px, -2px);
	}

	.tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--gray-800);
	}

	/* Tags are kept on a single row. */
	.tags {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.3rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.tags li {
		padding: 0.15rem 0.55rem;
		font-size: 0.8rem;
		white-space: nowrap;
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
		border-radius: 999rem;
	}

	.more {
		text-align: center;
		color: var(--gray-300);
	}

	/* Very narrow phones: tighten cards so tags still fit on one row. */
	@media (max-width: 22.5em) {
		.card {
			padding: 1.25rem 1rem;
		}

		.tags li {
			padding: 0.15rem 0.45rem;
			font-size: 0.75rem;
		}
	}
</style>
